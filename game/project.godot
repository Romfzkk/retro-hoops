config_version=5

[application]

config/name="Retro Hoops"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Game="*res://scripts/core/game_state.gd"
Net="*res://scripts/net/net_session.gd"
Sound="*res://scripts/core/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.806

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.06, 1)
